// Cloudflare Workers: раздаём собранную игру (npm run build → dist/) как статический сайт.
// Без этого файла `wrangler deploy` пытается настроить проект сам и требует Vite 6+.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldofwarcry-web",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist"
  },
  // Превью веток (`wrangler preview` в Workers Builds) требует этот блок, даже пустой.
  // Ассеты берутся из верхнего уровня, отдельных настроек превью игре не нужно.
  "previews": {}
}
