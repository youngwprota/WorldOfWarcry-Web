{
  "name": "warcry-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "import-assets": "node tools/import-assets.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "sim": "esbuild tools/sim.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.sim/sim.mjs && node .sim/sim.mjs",
    "tune": "esbuild tools/tune.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.sim/tune.mjs && node .sim/tune.mjs",
    "board": "node tools/board/server.mjs",
    "task": "node tools/board/cli.mjs"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.3.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
